{
  "name": "gh-conductor",
  "version": "0.2.0",
  "private": true,
  "description": "Read-only graph/ready/status commands plus a locally served graph view for gh-conductor. Requires bun and gh >= 2.94.",
  "bin": {
    "gh-conductor": "./src/cli/main.ts"
  },
  "type": "module",
  "scripts": {
    "test": "bun test",
    "check": "bun x tsc --noEmit -p tsconfig.json && bun x tsc --noEmit -p src/app/tsconfig.json && bun x oxlint && bun x oxfmt --check",
    "build": "bun scripts/build.ts",
    "serve": "bun src/cli/main.ts serve --dev",
    "fixtures": "bun scripts/build-fixtures.ts",
    "lint": "bun x oxlint",
    "fmt": "bun x oxfmt"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.33.0",
    "@tanstack/react-router": "^1.170.32",
    "@xyflow/react": "^12.11.5",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun-types": "^1.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.17"
  }
}
