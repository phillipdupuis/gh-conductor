{
  "name": "gh-conductor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only graph/ready/status commands plus a locally served graph view for gh-conductor. Requires bun and gh >= 2.94.",
  "bin": {
    "conductor": "./src/cli/main.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "bun x tsc --noEmit -p tsconfig.json && bun x tsc --noEmit -p src/app/tsconfig.json",
    "fixtures": "bun scripts/build-fixtures.ts",
    "serve": "bun --hot src/server/main.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
